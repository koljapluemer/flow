{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "sets": {
      "description": "Set ids",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "videos": {
      "description": "Video refs (<lang>/<platform id>), in any languages",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{3}/[^/]+$" }
    }
  }
}
