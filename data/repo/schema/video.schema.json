{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "platform", "platform_id", "immersion", "explanatory"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["youtube", "tiktok"] },
    "platform_id": { "description": "Video id on the platform", "type": "string", "minLength": 1 },
    "immersion": { "description": "Practiced snippet by snippet", "type": "boolean" },
    "explanatory": { "description": "Explains something about the language, watched as a whole", "type": "boolean" },
    "snippets": {
      "description": "Clips in video order, needed if immersion; a snippet's ref is <video ref>#<index>",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "text", "translation", "vocab", "core"],
        "properties": {
          "start": { "description": "Seconds", "type": "number", "minimum": 0 },
          "end": { "description": "Seconds", "type": "number", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "translation": { "type": "string", "minLength": 1 },
          "vocab": {
            "description": "Vocab refs (<lang>/<slug>) in the snippet",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]{3}/[^/]+$" }
          },
          "core": {
            "description": "Vocab refs needed to grasp the snippet, a subset of vocab",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]{3}/[^/]+$" }
          }
        }
      }
    },
    "credits": {
      "description": "Attribution, required for third-party content",
      "type": "array",
      "items": { "$ref": "credit.schema.json" }
    }
  }
}
