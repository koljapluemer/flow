{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentence",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "translation", "vocab"],
  "properties": {
    "text": { "type": "string", "minLength": 1 },
    "translation": { "type": "string", "minLength": 1 },
    "vocab": {
      "description": "Vocab refs (<lang>/<slug>) needed to understand the sentence",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{3}/[^/]+$" }
    },
    "credits": {
      "description": "Attribution, required for third-party content",
      "type": "array",
      "items": { "$ref": "credit.schema.json" }
    }
  }
}
