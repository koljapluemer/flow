{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "sentences"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "sentences": {
      "description": "Sentences and how each is practiced",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "mode"],
        "properties": {
          "ref": { "description": "Sentence ref (<lang>/<slug>)", "type": "string", "pattern": "^[a-z]{3}/[^/]+$" },
          "mode": {
            "description": "flashcard: repeated flashcards; guess-once: vocab first, then the sentence is guessed once; example: only a vocab example",
            "enum": ["flashcard", "guess-once", "example"]
          }
        }
      }
    }
  }
}
